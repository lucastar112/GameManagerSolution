<Page x:Class="DebugManager.Pages.MainMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#202020">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <WrapPanel Margin="30"
                   HorizontalAlignment="Center">

            <!-- Race Data -->
            <Border Width="300"
                    Height="240"
                    Margin="15"
                    CornerRadius="12"
                    Background="#303030"
                    Cursor="Hand"
                    MouseLeftButtonUp="RaceData_Click">

                <StackPanel>

                    <Image Source="/Assets/MenuPreviews/RaceData.png"
                           Height="170"
                           Stretch="UniformToFill"/>

                    <TextBlock Text="Race Data"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

            <!-- Scene Data -->
            <Border Width="300"
                    Height="240"
                    Margin="15"
                    CornerRadius="12"
                    Background="#303030"
                    Cursor="Hand">

                <StackPanel>

                    <Image Source="/Assets/MenuPreviews/SceneData.png"
                           Height="170"
                           Stretch="UniformToFill"/>

                    <TextBlock Text="Scene Data"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

        </WrapPanel>

    </ScrollViewer>

</Page>
