<Page x:Class="DebugManager.Pages.RaceDataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#202020">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Background="#303030">

            <Button Content="← Main Menu"
                    Width="130"
                    Height="40"
                    Margin="15"
                    HorizontalAlignment="Left"
                    Click="Back_Click"/>

            <TextBlock Text="Race Data"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

        </Grid>

        <!-- Race not started message -->
        <TextBlock x:Name="RaceStatusText"
           Grid.Row="1"
           Text="{Binding StatusMessage}"
           Foreground="#CCCCCC"
           FontSize="24"
           FontWeight="Bold"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"/>

        <!-- Player list -->
        <ScrollViewer x:Name="PlayerScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="Collapsed">

            <ItemsControl ItemsSource="{Binding Players}"
                          Margin="25">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border Width="350"
                                Height="230"
                                Margin="10"
                                Padding="15"
                                Background="{Binding TeamColor}"
                                CornerRadius="10">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Character + vehicle -->
                                <Grid Grid.Column="0"
                                      Width="120"
                                      Height="145">

                                    <Border Width="110"
                                            Height="110"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            CornerRadius="8"
                                            Background="#404040">

                                        <Image Source="{Binding CharacterImage}"
                                               Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- Vehicle -->
                                    <Border Width="48"
                                            Height="48"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,-5,-5,0"
                                            CornerRadius="24"
                                            Background="#505050"
                                            BorderBrush="#202020"
                                            BorderThickness="3">

                                        <Image Source="{Binding VehicleImage}"
                                               Stretch="Uniform"/>
                                    </Border>

                                    <!-- Character name -->
                                    <TextBlock Text="{Binding Character}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Bottom"
                                               Width="110"
                                               Foreground="White"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>

                                </Grid>

                                <!-- Player information -->
                                <StackPanel Grid.Column="1"
                                            Margin="15,0,0,0">

                                    <TextBlock Text="{Binding Name}"
                                               Foreground="White"
                                               FontSize="20"
                                               FontWeight="Bold"/>

                                    <TextBlock Text="{Binding Vehicle}"
                                               Foreground="#CCCCCC"
                                               Margin="0,8,0,0"/>

                                    <TextBlock Text="{Binding MaxSpeedText}"
                                               Foreground="#CCCCCC"
                                               Margin="0,12,0,0"/>

                                    <TextBlock Text="{Binding CurrentSpeedText}"
                                               Foreground="#CCCCCC"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</Page>